# Source distribution contents. The wheel is unaffected: it carries only
# the labctl package (plus the web templates/static and the bundled
# Claude Code skills in package-data).
#
# The sdist adds what's needed to run the tests and to install the
# services from it: tests, config samples and systemd units, scripts and
# docs.
include README.md LICENSE CHANGELOG.md SECURITY.md pyproject.toml
graft src
graft tests
graft config
graft docs
graft scripts

# Development notes, not documentation.
prune docs/development

global-exclude *.py[cod] *.so .DS_Store *.swp
prune build
prune dist
