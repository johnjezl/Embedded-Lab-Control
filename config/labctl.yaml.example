# Lab Controller Configuration
#
# Copy this file to ~/.config/labctl/config.yaml (or, for the system
# services, /etc/labctl/config.yaml) and customize as needed. Search order:
# -c FILE, $LABCTL_CONFIG, ~/.config/labctl/config.yaml,
# /etc/labctl/config.yaml, built-in defaults.
#
# Only these environment variables override settings (keys marked
# "not used yet" below are parsed but nothing acts on them):
#   LABCTL_DEV_DIR            serial.dev_dir
#   LABCTL_BASE_TCP_PORT      serial.base_tcp_port (not used yet)
#   LABCTL_DATABASE_PATH      database_path
#   LABCTL_DATABASE_TIMEOUT   database.timeout_seconds
#   LABCTL_LOG_LEVEL          log_level
#   LABCTL_PROXY_ENABLED      proxy.enabled (not used yet)
#   LABCTL_PROXY_PORT_BASE    proxy.port_base
#   LABCTL_PROXY_WRITE_POLICY proxy.write_policy
#   LABCTL_PROXY_LOG_DIR      proxy.log_dir
# LABCTL_CONFIG names the config file (LABCTL_CONFIG_EXCLUSIVE=1: only that
# file), and LABCTL_SYSTEM_CONFIG replaces /etc/labctl/config.yaml.

# Serial port settings
serial:
  # Directory where udev creates symlinks for lab devices
  dev_dir: /dev/lab

  # Base TCP port for ser2net connections. Not used yet: automatic port
  # assignment always starts at 4000 (`port assign -t` picks one).
  base_tcp_port: 4000

  # Default baud rate for serial connections
  default_baud: 115200

# ser2net integration
ser2net:
  # Path to ser2net configuration file
  config_file: /etc/ser2net.yaml

  # Enable ser2net integration (set to false for direct serial only)
  enabled: true

# Multi-client serial proxy (`labctl proxy start`); defaults shown.
# proxy:
#   enabled: true              # not used yet: `proxy start` always runs
#   port_base: 5500
#   port_range: 100            # ports 5500-5599
#   write_policy: first        # first, all or queue
#   log_dir: ~/.local/share/labctl/logs   # default: $XDG_DATA_HOME/labctl/logs
#   log_retention_days: 7      # not used yet: logs are never pruned
#   max_clients: 10
#   idle_timeout: 3600         # not used yet: idle clients stay connected

# Health checks and the monitor daemon (`labctl monitor`); defaults shown.
# health:
#   check_interval: 10         # seconds between ping + serial checks
#   power_check_interval: 60   # seconds between power-plug probes
#   min_sleep_seconds: 1.0
#   ping_timeout: 2.0
#   serial_timeout: 2.0
#   status_retention_days: 30  # not used yet: status history isn't pruned
#   alert_log_path: ~/.local/share/labctl/alerts.log  # default: $XDG_DATA_HOME/labctl/alerts.log
#   alert_on_offline: true
#   alert_on_power_change: true
#   update_status_on_check: true  # not used yet: use `monitor --no-update`

# Authentication (disabled by default). Also secures `labctl mcp --http`:
# with auth enabled, MCP HTTP clients must send
# "Authorization: Bearer <api_key>" using one of these users' API keys.
# auth:
#   enabled: true
#   secret_key: "generate-a-random-string"
#   session_lifetime_minutes: 480
#   users:
#     - username: admin
#       password_hash: "generate with: labctl user hash-password"
#       api_key: "generate with: labctl user generate-key"
#       # role: operator (default) may act on boards other users have
#       # claimed (override_claim on REST, the web UI's override button)
#       # and force-release their claims (also over MCP, with
#       # force_release_sbc). Give AI agents role: agent: they can claim
#       # and use free boards, but a board someone else holds they can
#       # only ask for (request_sbc_release).
#     - username: "fw-dev"
#       api_key: "generate with: labctl user generate-key"
#       role: agent

# Claims (exclusive access to a board). MCP tools, the REST API, the web UI
# and the CLI refuse to change a board someone else has claimed. Hardware
# boards share (a plug outlet, SDWire, console adapter, relay board) is
# covered too: using it through another board, or wiring it to one, is
# refused while one of its boards is claimed.
# Operators may override on REST and the web UI, and anyone may with the
# CLI's --override-claim; each override is recorded in the activity log.
# Over MCP there is no override: an operator force-releases the claim.
# See docs/OPERATIONS.md for what is and isn't checked.
# claims:
#   # false: changes are no longer checked against claims, on any
#   # interface (docs/OPERATIONS.md lists the few exceptions).
#   enabled: true
#   # Refuse MCP and REST calls that change a board unless the caller has
#   # claimed it first (not the CLI or web UI, whose users are people).
#   # Recommended when several agents share the lab. Needs claims
#   # enabled.
#   require_claim: false
#   # Claim durations, in whole minutes. A claim asking for a duration
#   # outside min..max is refused; inconsistent values here are corrected
#   # at load, with a warning.
#   default_duration_minutes: 30
#   min_duration_minutes: 1
#   max_duration_minutes: 1440
#   # After a claim expires, only its holder can claim the board again for
#   # this long. The expired claim no longer protects the board or can be
#   # renewed: renew before it expires.
#   grace_period_seconds: 60
#   # Released claims older than this are pruned by `labctl claims expire`
#   # and by the MCP server's periodic sweep (which also prunes activity
#   # events older than 30 days; that age isn't configurable).
#   auto_prune_released_after_days: 30

# Web server SSL/TLS (disabled by default, serves HTTP)
# To enable HTTPS, generate a self-signed certificate:
#   sudo mkdir -p /etc/labctl/ssl
#   sudo openssl req -x509 -newkey rsa:4096 -nodes \
#     -keyout /etc/labctl/ssl/key.pem -out /etc/labctl/ssl/cert.pem \
#     -days 365 -subj "/CN=labctl"
# Or use --cert and --key CLI flags for ad-hoc usage.
# web:
#   cert_file: "/etc/labctl/ssl/cert.pem"
#   key_file: "/etc/labctl/ssl/key.pem"

# TP-Link Kasa device credentials
# Required for newer Kasa devices that use KLAP protocol authentication.
# Use your TP-Link cloud account (same as Kasa app login).
# kasa:
#   username: "your-tplink-email@example.com"
#   password: "your-tplink-password"

# MCP server (`labctl mcp`): host file access is denied unless listed here.
# allowed_read_paths:  directories tools may read (flash images, files to
#                      copy onto SD cards: flash_image, sdwire_update, boot_test)
# allowed_write_paths: directories tools may write (boot_test output_dir)
# Paths are resolved (symlinks, "..") before the check. The CLI is not
# restricted by these settings. scripts/install-services.sh creates both
# directories (group-writable by `labctl`).
mcp:
  allowed_read_paths:
    - /var/lib/labctl/images
  allowed_write_paths:
    - /var/lib/labctl/output
  # HTTP transport: clients upload images with PUT /images/<name> (same
  # port and API key as /mcp) into this directory; tools then take the bare
  # name. Keep it inside allowed_read_paths. Empty = uploads off.
  upload_dir: /var/lib/labctl/images
  # max_upload_mb: 8192
  # HTTPS for the HTTP transport (or labctl mcp --cert/--key); the web
  # server's certificate can be reused.
  # cert_file: /etc/labctl/tls/cert.pem
  # key_file: /etc/labctl/tls/key.pem
  # Destructive tools (power off/cycle, flash, serial_send, ...) need a
  # second call with the confirm_token the first call returns.
  # confirm_destructive: true
  # confirm_exempt: [serial_send]
  # HTTP transport: extra accepted Host / Origin headers, e.g. when a
  # reverse proxy forwards its public name ("name:*" = any port). Loopback
  # names are always accepted when bound to 127.0.0.1.
  # allowed_hosts: ["lab.example.com", "lab.example.com:*"]
  # allowed_origins: ["https://lab.example.com"]
  # Security gate: actuator_add / actuator_remove / actuator_set (raw relay
  # access that bypasses bindings) are refused over MCP unless this is
  # true (a YAML boolean; any other value keeps them off, with a warning).
  # Default false.
  # allow_admin_actuator_ops: false

# SQLite busy-wait when another process holds a write lock (seconds).
# database:
#   timeout_seconds: 10.0

# Database path for SBC and resource tracking. `~` is the home of whoever
# runs labctl: in /etc/labctl/config.yaml use an absolute path (e.g.
# /var/lib/labctl/.config/labctl/labctl.db, which install-services.sh
# writes), or each user and the services get a database of their own.
database_path: ~/.config/labctl/labctl.db

# Logging level (DEBUG, INFO, WARNING, ERROR); WARNING when unset
log_level: INFO
