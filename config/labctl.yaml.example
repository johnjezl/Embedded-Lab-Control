# Lab Controller Configuration
#
# Copy this file to ~/.config/labctl/config.yaml and customize as needed.
# Environment variables can override any setting (see documentation).

# Serial port settings
serial:
  # Directory where udev creates symlinks for lab devices
  dev_dir: /dev/lab

  # Base TCP port for ser2net connections (ports assigned sequentially)
  base_tcp_port: 4000

  # Default baud rate for serial connections
  default_baud: 115200

# ser2net integration
ser2net:
  # Path to ser2net configuration file
  config_file: /etc/ser2net.yaml

  # Enable ser2net integration (set to false for direct serial only)
  enabled: true

# Authentication (disabled by default)
# auth:
#   enabled: true
#   secret_key: "generate-a-random-string"
#   session_lifetime_minutes: 480
#   users:
#     - username: admin
#       password_hash: "generate with: labctl user hash-password"
#       api_key: "generate with: labctl user generate-key"

# Web server SSL/TLS (disabled by default, serves HTTP)
# To enable HTTPS, generate a self-signed certificate:
#   sudo mkdir -p /etc/labctl/ssl
#   sudo openssl req -x509 -newkey rsa:4096 -nodes \
#     -keyout /etc/labctl/ssl/key.pem -out /etc/labctl/ssl/cert.pem \
#     -days 365 -subj "/CN=labctl"
# Or use --cert and --key CLI flags for ad-hoc usage.
# web:
#   cert_file: "/etc/labctl/ssl/cert.pem"
#   key_file: "/etc/labctl/ssl/key.pem"

# TP-Link Kasa device credentials
# Required for newer Kasa devices that use KLAP protocol authentication.
# Use your TP-Link cloud account (same as Kasa app login).
# kasa:
#   username: "your-tplink-email@example.com"
#   password: "your-tplink-password"

# MCP server (`labctl mcp`): host file access is denied unless listed here.
# allowed_read_paths:  directories tools may read (flash images, files to
#                      copy onto SD cards: flash_image, sdwire_update, boot_test)
# allowed_write_paths: directories tools may write (boot_test output_dir)
# Paths are resolved (symlinks, "..") before the check. The CLI is not
# restricted by these settings. scripts/install-services.sh creates both
# directories (group-writable by `labctl`).
mcp:
  allowed_read_paths:
    - /var/lib/labctl/images
  allowed_write_paths:
    - /var/lib/labctl/output
  # Destructive tools (power off/cycle, flash, serial_send, ...) need a
  # second call with the confirm_token the first call returns.
  # confirm_destructive: true
  # confirm_exempt: [serial_send]

# Database path for SBC and resource tracking
database_path: ~/.config/labctl/labctl.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
log_level: INFO
