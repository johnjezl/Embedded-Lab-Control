# Example port mapping for udev rule generation (legacy)
#
# Read only by scripts/generate-udev-rules.py (--mapping FILE); labctl
# itself never reads it. The current workflow registers adapters in the
# database instead: `labctl serial add <name> <usb_path>`, then
# `labctl serial udev --install --reload`.
#
# This file maps physical USB paths to logical device names (symlinks
# /dev/lab/<name>). Only usb_path and name are used; vendor and model are
# informational (the generated rule comments use the detected device's
# vendor/model instead). USB paths can be discovered using:
# ./scripts/discover-usb-serial.sh
#
# Copy this file to port-mapping.yaml and customize for your setup.

ports:
  # ST-Link debugger on hub port 1-10.1.2
  - usb_path: "1-10.1.2"
    name: "stlink-debug"
    vendor: "STMicroelectronics"
    model: "STM32_STLink"

  # Console ports for SBCs
  - usb_path: "1-10.1.3"
    name: "sbc1-console"
    vendor: "Silicon_Labs"
    model: "CP2102"

  - usb_path: "1-10.1.4"
    name: "sbc2-console"
    vendor: "Silicon_Labs"
    model: "CP2102"

  # Additional serial adapters
  - usb_path: "1-10.3"
    name: "dev-serial1"
    vendor: "QinHeng"
    model: "CH340"

  - usb_path: "1-10.4"
    name: "dev-serial2"
    vendor: "QinHeng"
    model: "CH340"
